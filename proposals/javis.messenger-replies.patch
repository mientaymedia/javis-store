@@ -0,0 +1,104 @@
+"""Store pack: private Messenger reactions and reply_to, with no network.
+
+Run with:
+    JAVIS_OS_DIR=../javis-os python tests/javis.messenger-replies/test_messenger_replies.py
+"""
+from __future__ import annotations
+
+import asyncio
+import importlib.util
+import os
+import sys
+from pathlib import Path
+
+STORE = Path(__file__).resolve().parents[2]
+OS_ROOT = Path(os.environ.get("JAVIS_OS_DIR") or "../javis-os").resolve()
+SERVER = OS_ROOT / "server"
+sys.path.insert(0, str(SERVER))
+
+import bot_reaction  # noqa: E402
+import messenger_bot  # noqa: E402
+
+PLUGIN = STORE / "packs" / "javis.messenger-replies" / "plugins" / "messenger-replies" / "plugin.py"
+spec = importlib.util.spec_from_file_location("store_messenger_replies", PLUGIN)
+module = importlib.util.module_from_spec(spec)
+assert spec and spec.loader
+spec.loader.exec_module(module)
+module.register(object())
+
+fails = []
+
+
+def check(name, condition, detail=""):
+    print(("ok   " if condition else "FAIL ") + name + (f" [{detail}]" if detail and not condition else ""))
+    if not condition:
+        fails.append(name)
+
+
+PAGE = "123456789"
+TOKEN = "EAA-test"
+
+
+async def turn(meta, answer):
+    calls = []
+
+    class Response:
+        status_code = 200
+
+        @staticmethod
+        def json():
+            return {"message_id": "out-1"}
+
+    class Client:
+        async def post(self, url, json=None, params=None):
+            calls.append((url.rsplit("/", 2)[-2] + "/" + url.rsplit("/", 1)[-1], dict(json or {})))
+            return Response()
+
+    async def answer_fn(text, received_meta, progress):
+        return dict(answer)
+
+    bot = messenger_bot.MessengerBot({"page_id": PAGE, "access_token": TOKEN, "app_secret": "secret"}, "",
+                                     answer_fn, giau_trang_thai=True)
+
+    client = Client()
+    bot._client = client
+    await bot._handle_turn(client, str(meta.get("chat_id") or "customer-1"), "Xin chào", meta)
+    return calls
+
+
+private = asyncio.run(turn(
+    {"chat_id": "customer-1", "message_id": "in-1"},
+    {"text": "Dạ em nghe ạ", "reaction": "heart"},
+))
+check("private reply is anchored to the inbound message",
+      any(p.get("message") and p.get("reply_to") == {"mid": "in-1"} for _, p in private), private)
+check("private reaction targets the inbound message",
+      any(p.get("sender_action") == "REACT" and p.get("payload") == "❤️"
+          and p.get("reply_to") == {"mid": "in-1"} for _, p in private), private)
+
+reaction_only = asyncio.run(turn(
+    {"chat_id": "customer-2", "message_id": "in-2"},
+    {"text": "", "files": [], "im_lang": True, "reaction": "like"},
+))
+check("reaction-only turn sends a reaction without a text bubble",
+      any(p.get("sender_action") == "REACT" and p.get("payload") == "👍" for _, p in reaction_only)
+      and not any(p.get("message") for _, p in reaction_only), reaction_only)
+
+comment = asyncio.run(turn(
+    {"chat_id": "cmt:root-1", "message_id": "comment-1", "comment": True},
+    {"text": "Em đã nhận bình luận", "reaction": "heart"},
+))
+check("public comments get neither a reaction nor reply_to",
+      not any(p.get("sender_action") == "REACT" or p.get("reply_to") for _, p in comment), comment)
+
+instagram = asyncio.run(turn(
+    {"chat_id": "ig:user-1", "message_id": "ig-1", "instagram": True},
+    {"text": "Hello", "reaction": "heart"},
+))
+check("Instagram gets neither a reaction nor reply_to",
