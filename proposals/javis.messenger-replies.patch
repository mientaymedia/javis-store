+format: javis-pack
+spec: 1
+
+id: javis.messenger-replies
+version: 1.0.0
+name:
+  vi: Messenger trả lời tự nhiên
+  en: Natural Messenger replies
+description:
+  vi: Cho chatbot Messenger thả cảm xúc phù hợp và gắn câu trả lời vào đúng tin khách vừa nhắn. Chỉ áp dụng cho inbox riêng Facebook, không áp dụng cho bình luận hay Instagram.
+  en: Lets Messenger chatbots react appropriately and attach each answer to the exact customer message. Applies only to private Facebook Page inboxes, not comments or Instagram.
+
+author:
+  name: Javis
+license: MIT
+homepage: https://github.com/blogminhquy/javis-store
+
+# This plugin patches private Messenger turns in Javis 0.611.x. Keep the upper bound so a
+# future core transport change cannot leave a stale runtime patch enabled silently.
+compat:
+  app: ">=0.611.0,<0.612.0"
+
+provides:
+  plugins:
+    - plugins/messenger-replies
diff --git a/packs/javis.messenger-replies/plugins/messenger-replies/plugin.py b/packs/javis.messenger-replies/plugins/messenger-replies/plugin.py
new file mode 100644
index 0000000..fa33d58
--- /dev/null
+++ b/packs/javis.messenger-replies/plugins/messenger-replies/plugin.py
@@ -0,0 +1,124 @@
+"""Add reactions and native message replies to private Facebook Page inbox turns.
+
+This is intentionally a narrow compatibility patch for Javis 0.611.x. It does not add a
+new Facebook client or store credentials. It reuses the connected Page transport and only
+changes a live private Messenger turn in two ways:
+
+1. Messenger becomes eligible for the existing `[CAM_XUC:<name>]` agent contract. The chosen
+   emoji is sent with Meta's REACT sender action against the inbound message id.
+2. The first text chunk carries `reply_to.mid`, so Messenger renders it as a reply to the
+   exact customer message instead of an unanchored bubble.
+
+Comments and Instagram turns are excluded. The patch is task-local through a ContextVar,
+so simultaneous conversations cannot leak message ids into each other. Installing a code
+pack leaves it disabled until the owner reviews and enables it in Javis.
+"""
+from __future__ import annotations
+
+from contextvars import ContextVar
+from typing import Any, Optional
+
+_TURN = ContextVar("javis_messenger_reply_turn", default=None)
+_PATCHED = False
+
+
+def _supported(meta: Optional[dict]) -> bool:
+    turn = meta or {}
+    return bool(turn.get("message_id")) and not turn.get("comment") and not turn.get("instagram")
+
+
+class _ReactionChannels(tuple):
+    """Tuple-compatible channel list whose Messenger membership is scoped to a live private turn."""
+
+    def __new__(cls, values):
+        items = tuple(values or ())
+        if not tuple.__contains__(items, "messenger"):
+            items += ("messenger",)
+        return super().__new__(cls, items)
+
+    def __contains__(self, item):
+        if item == "messenger":
+            state = _TURN.get()
+            return bool(state and _supported(state.get("meta")))
+        return tuple.__contains__(self, item)
+
+
+def _wrap_answer(bot, bot_reaction) -> None:
+    if getattr(bot, "_store_messenger_replies_answer", False) or not callable(getattr(bot, "answer_fn", None)):
+        return
+    original = bot.answer_fn
+
+    async def answer(text, meta=None, progress=None):
+        result = await original(text, meta, progress)
+        reaction = result.get("reaction") if isinstance(result, dict) else None
+        emoji = bot_reaction.emoji_of(reaction)
+        if emoji and _supported(meta) and getattr(bot, "_client", None) is not None:
+            payload = {
+                "recipient": {"id": str((meta or {}).get("chat_id") or "")},
+                "sender_action": "REACT",
+                "payload": emoji,
+                "reply_to": {"mid": str((meta or {}).get("message_id") or "")},
+            }
+            try:
+                await bot._post_json(bot._client, f"{bot.page_id}/messages", payload)
+            except Exception:
+                # A failed decorative reaction must never cost the customer the actual answer.
+                pass
+        return result
+
+    bot.answer_fn = answer
+    bot._store_messenger_replies_answer = True
+
+
+def _install() -> None:
+    global _PATCHED
+    if _PATCHED:
+        return
+
+    import bot_reaction
+    import messenger_bot
+
+    bot_reaction.CHANNELS = _ReactionChannels(bot_reaction.CHANNELS)
+    bot_class = messenger_bot.MessengerBot
+
+    original_init = bot_class.__init__
+    original_handle_turn = bot_class._handle_turn
+    original_post_json = bot_class._post_json
+
+    def init(self, *args, **kwargs):
+        original_init(self, *args, **kwargs)
+        _wrap_answer(self, bot_reaction)
+
+    async def handle_turn(self, client, chat, text, meta=None):
+        state = {"meta": dict(meta or {}), "reply_sent": False}
+        token = _TURN.set(state)
+        try:
+            return await original_handle_turn(self, client, chat, text, meta)
+        finally:
+            _TURN.reset(token)
+
+    async def post_json(self, client, path, payload):
+        state = _TURN.get()
+        body = payload
+        if (state and _supported(state.get("meta")) and not state.get("reply_sent")
+                and path == f"{self.page_id}/messages" and isinstance(payload, dict)
+                and payload.get("message") and not payload.get("reply_to")):
+            body = dict(payload)
+            body["reply_to"] = {"mid": str(state["meta"]["message_id"])}
+            state["reply_sent"] = True
+        return await original_post_json(self, client, path, body)
+
+    bot_class.__init__ = init
+    bot_class._handle_turn = handle_turn
+    bot_class._post_json = post_json
+    bot_class._store_messenger_replies_patch = True
+
+    # A plugin can be enabled after bots were constructed. Cover those instances too.
+    for bot in (messenger_bot.registered() or {}).values():
+        _wrap_answer(bot, bot_reaction)
+
+    _PATCHED = True
+
+
+def register(ctx: Any) -> None:
+    _install()
